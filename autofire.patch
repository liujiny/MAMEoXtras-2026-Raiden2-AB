+static int g_autoFireGameInput = 0;
+
+void XboxAutoFireBeginFrame(void)
+{
+    int player;
+    g_autoFireGameInput = 0;
+    for (player = 0; player < AUTOFIRE_PLAYERS; ++player)
+    {
+        const XINPUT_GAMEPAD *pad = GetGamepadState(player);
+        int heldA = pad && pad->bAnalogButtons[XINPUT_GAMEPAD_A] > ANALOG_BUTTON_AS_DIGITAL_DEADZONE;
+        int heldB = pad && pad->bAnalogButtons[XINPUT_GAMEPAD_B] > ANALOG_BUTTON_AS_DIGITAL_DEADZONE;
+        AutoFireStep(&g_autoFireState[player][AUTOFIRE_A], heldA,
+                     g_autoFireEnabled[player][AUTOFIRE_A]);
+        AutoFireStep(&g_autoFireState[player][AUTOFIRE_B], heldB,
+                     g_autoFireEnabled[player][AUTOFIRE_B]);
+    }
+}
+
+void XboxAutoFireSetGameInput(int enabled)
+{
+    g_autoFireGameInput = enabled;
+}
