+void COptionsScreen::DrawAutoFirePage( void )
+{
+  STARTPAGE();
+  for (UINT32 player = 0; player < AUTOFIRE_PLAYERS; ++player)
+  {
+    WCHAR name[64];
+    swprintf(name, L"P%u A button auto fire", player + 1);
+    DRAWITEM(name, g_autoFireEnabled[player][AUTOFIRE_A] ? L"Enabled" : L"Disabled");
+    swprintf(name, L"P%u B button auto fire", player + 1);
+    DRAWITEM(name, g_autoFireEnabled[player][AUTOFIRE_B] ? L"Enabled" : L"Disabled");
+  }
+  ENDPAGE();
+}
+
+void COptionsScreen::ChangeAutoFirePage( BOOL movingRight )
+{
+  UINT32 row = (UINT32)m_cursorPosition;
+  if (row < AUTOFIRE_PLAYERS * AUTOFIRE_BUTTONS)
+  {
+    int &enabled = g_autoFireEnabled[row / AUTOFIRE_BUTTONS][row % AUTOFIRE_BUTTONS];
+    if (enabled != (movingRight != FALSE))
+    {
+      enabled = movingRight != FALSE;
+      SaveOptions();
+    }
+  }
+}
+
+void DrawAutoFirePage( COptionsScreen *ptr )
+{
+  ptr->DrawAutoFirePage();
+}
+
+void ChangeAutoFirePage( COptionsScreen *ptr, BOOL movingRight )
+{
+  ptr->ChangeAutoFirePage(movingRight);
+}
